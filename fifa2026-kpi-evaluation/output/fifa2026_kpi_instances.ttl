inst:kpi-attendance_by_stage a kpi:KeyPerformanceIndicator ;
    kpi:aggregationPropertyURI "https://data.adorsys.com/ontology/sport/football/attendance"^^xsd:anyURI ;
    kpi:dataSourceURI "file:fifa2026-kpi-evaluation/input/fifa-world-cup-2026_instances.ttl"^^xsd:anyURI ;
    kpi:hasAggregationOperator kpi:Average ;
    kpi:hasAggregationResult inst:result-attendance_by_stage-001,
        inst:result-attendance_by_stage-002,
        inst:result-attendance_by_stage-003,
        inst:result-attendance_by_stage-004,
        inst:result-attendance_by_stage-005,
        inst:result-attendance_by_stage-006 ;
    kpi:hasGranularityDimension inst:dim-attendance_by_stage-stage ;
    kpi:kpiLabel "Average attendance by tournament stage" ;
    kpi:referenceOntologyURI "https://data.adorsys.com/ontology/sport/football/"^^xsd:anyURI .

