:image rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "image"@en ;
    rdfs:comment "URL of a representative image for a country, person, team, venue, or host city."@en ;
    rdfs:domain :Country , :Person , :Team , :Venue , :HostCity ;
