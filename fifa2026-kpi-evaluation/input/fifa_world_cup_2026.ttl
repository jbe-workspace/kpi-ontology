    rdfs:domain :MatchTeamStatistics ;
    rdfs:range xsd:integer .

:yellowCardsCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "yellow cards count"@en ;
    rdfs:comment "Number of yellow cards for this side in this match (aggregate count, distinct from individual :Booking events)."@en ;
    rdfs:domain :MatchTeamStatistics ;
    rdfs:range xsd:integer .

:yellowRedCardsCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "yellow-red cards count"@en ;
    rdfs:domain :MatchTeamStatistics ;
    rdfs:range xsd:integer .

:redCardsCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "red cards count"@en ;
    rdfs:domain :MatchTeamStatistics ;
    rdfs:range xsd:integer .

# --- MatchEvent properties ---

:minute rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minute"@en ;
    rdfs:comment "The minute of the match when the event occurred."@en ;
    rdfs:domain :MatchEvent ;
    rdfs:range xsd:integer .

:extraTimeMinute rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "extra time minute"@en ;
    rdfs:comment "Added/stoppage time minutes beyond the indicated minute."@en ;
    rdfs:domain :MatchEvent ;
    rdfs:range xsd:integer .

:goalType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "goal type"@en ;
    rdfs:comment "Type of goal: REGULAR, OWN, or PENALTY."@en ;
    rdfs:domain :Goal ;
    rdfs:range xsd:string .

:cardType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "card type"@en ;
    rdfs:comment "Type of booking: YELLOW_CARD, RED_CARD, or SECOND_YELLOW."@en ;
    rdfs:domain :Booking ;
    rdfs:range xsd:string .

# --- Venue properties ---

:venueName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "venue name"@en ;
    rdfs:comment "The common name of the stadium."@en ;
    rdfs:domain :Venue ;
    rdfs:range xsd:string .

:fifaName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "FIFA name"@en ;
    rdfs:comment "The official FIFA tournament name for the venue (without commercial sponsors)."@en ;
    rdfs:domain :Venue ;
    rdfs:range xsd:string .

:capacity rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity"@en ;
    rdfs:comment "The seating capacity of the venue."@en ;
    rdfs:domain :Venue ;
    rdfs:range xsd:integer .

:isIndoor rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is indoor"@en ;
    rdfs:comment "Whether the venue has a retractable roof or is fully enclosed."@en ;
    rdfs:domain :Venue ;
    rdfs:range xsd:boolean .

:inception rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inception date"@en ;
    rdfs:comment "Date the venue was opened/inaugurated."@en ;
    rdfs:domain :Venue ;
    rdfs:range xsd:date .

:coordinates rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "coordinates"@en ;
    rdfs:comment "Geographic coordinates from enrichment sources (often WKT point string)."@en ;
    rdfs:domain :Country , :Venue , :HostCity ;
    rdfs:range xsd:string .

:officialWebsite rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "official website"@en ;
    rdfs:comment "Official website URL for a country, team, venue, or host city."@en ;
    rdfs:domain :Country , :Team , :Venue , :HostCity ;
    rdfs:range xsd:anyURI .

