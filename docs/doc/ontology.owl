        <rdfs:label xml:lang="en">Variance</rdfs:label>
        <rdfs:label xml:lang="de">Varianz</rdfs:label>
        <skos:definition xml:lang="de">Berechnet die Varianz der Werte in der aggregierten Menge als Quadrat der Standardabweichung. Nicht als native SPARQL-Funktion verfügbar, aber in einigen Triplestore-Erweiterungen unterstützt.</skos:definition>
        <skos:definition xml:lang="en">Computes the variance of values in the aggregated set as the square of the standard deviation. Not available as a native SPARQL function but supported in some triplestore extensions.</skos:definition>
        <skos:inScheme rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <skos:notation>VAR</skos:notation>
        <skos:prefLabel xml:lang="en">Variance</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Varianz</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
    </owl:NamedIndividual>
    


