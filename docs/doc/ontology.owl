    <!-- https://semantic.adorsys.com/meta/kpi/Max -->


    <owl:NamedIndividual rdf:about="https://semantic.adorsys.com/meta/kpi/Max">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperator"/>
        <rdfs:isDefinedBy rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <rdfs:label xml:lang="de">Maximum</rdfs:label>
        <rdfs:label xml:lang="en">Maximum</rdfs:label>
        <skos:definition xml:lang="en">Determines the largest value in the aggregated set. Corresponds to the SPARQL function MAX().</skos:definition>
        <skos:definition xml:lang="de">Ermittelt den größten Wert in der aggregierten Menge. Entspricht der SPARQL-Funktion MAX().</skos:definition>
        <skos:inScheme rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <skos:notation>MAX</skos:notation>
        <skos:prefLabel xml:lang="de">Maximum</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Maximum</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
    </owl:NamedIndividual>
    


    <!-- https://semantic.adorsys.com/meta/kpi/Median -->


    <owl:NamedIndividual rdf:about="https://semantic.adorsys.com/meta/kpi/Median">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperator"/>
        <rdfs:isDefinedBy rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <rdfs:label xml:lang="de">Median</rdfs:label>
        <rdfs:label xml:lang="en">Median</rdfs:label>
        <skos:definition xml:lang="en">Determines the middle value of the sorted aggregated set, separating the upper half from the lower half. Not available as a native SPARQL function but can be computed through subqueries.</skos:definition>
        <skos:definition xml:lang="de">Ermittelt den Zentralwert der sortierten aggregierten Menge, der die obere von der unteren Hälfte trennt. Nicht als native SPARQL-Funktion verfügbar, kann aber durch Unterabfragen berechnet werden.</skos:definition>
        <skos:inScheme rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <skos:notation>MEDIAN</skos:notation>
        <skos:prefLabel xml:lang="de">Median</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Median</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
    </owl:NamedIndividual>
    


    <!-- https://semantic.adorsys.com/meta/kpi/Min -->


    <owl:NamedIndividual rdf:about="https://semantic.adorsys.com/meta/kpi/Min">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperator"/>
        <rdfs:isDefinedBy rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <rdfs:label xml:lang="de">Minimum</rdfs:label>
        <rdfs:label xml:lang="en">Minimum</rdfs:label>
        <skos:definition xml:lang="en">Determines the smallest value in the aggregated set. Corresponds to the SPARQL function MIN().</skos:definition>
        <skos:definition xml:lang="de">Ermittelt den kleinsten Wert in der aggregierten Menge. Entspricht der SPARQL-Funktion MIN().</skos:definition>
        <skos:inScheme rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <skos:notation>MIN</skos:notation>
        <skos:prefLabel xml:lang="de">Minimum</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Minimum</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
    </owl:NamedIndividual>
    


    <!-- https://semantic.adorsys.com/meta/kpi/Sample -->


    <owl:NamedIndividual rdf:about="https://semantic.adorsys.com/meta/kpi/Sample">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperator"/>
        <rdfs:isDefinedBy rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <rdfs:label xml:lang="en">Sample</rdfs:label>
        <rdfs:label xml:lang="de">Stichprobe</rdfs:label>
        <skos:definition xml:lang="en">Selects an arbitrary representative value from the aggregated set. Corresponds to the SPARQL function SAMPLE().</skos:definition>
        <skos:definition xml:lang="de">Wählt einen beliebigen repräsentativen Wert aus der aggregierten Menge aus. Entspricht der SPARQL-Funktion SAMPLE().</skos:definition>
        <skos:inScheme rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <skos:notation>SAMPLE</skos:notation>
        <skos:prefLabel xml:lang="en">Sample</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Stichprobe</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
    </owl:NamedIndividual>
    


    <!-- https://semantic.adorsys.com/meta/kpi/StandardDeviation -->


    <owl:NamedIndividual rdf:about="https://semantic.adorsys.com/meta/kpi/StandardDeviation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperator"/>
        <rdfs:isDefinedBy rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <rdfs:label xml:lang="en">Standard Deviation</rdfs:label>
        <rdfs:label xml:lang="de">Standardabweichung</rdfs:label>
        <skos:definition xml:lang="de">Berechnet die Standardabweichung der Werte in der aggregierten Menge als Maß für die Streuung um den Mittelwert. Nicht als native SPARQL-Funktion verfügbar, aber in einigen Triplestore-Erweiterungen unterstützt.</skos:definition>
        <skos:definition xml:lang="en">Computes the standard deviation of values in the aggregated set as a measure of dispersion around the mean. Not available as a native SPARQL function but supported in some triplestore extensions.</skos:definition>
        <skos:inScheme rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <skos:notation>STDEV</skos:notation>
        <skos:prefLabel xml:lang="en">Standard Deviation</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Standardabweichung</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
    </owl:NamedIndividual>
    


    <!-- https://semantic.adorsys.com/meta/kpi/Sum -->


    <owl:NamedIndividual rdf:about="https://semantic.adorsys.com/meta/kpi/Sum">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperator"/>
        <rdfs:isDefinedBy rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <rdfs:label xml:lang="en">Sum</rdfs:label>
        <rdfs:label xml:lang="de">Summe</rdfs:label>
        <skos:definition xml:lang="de">Berechnet die Gesamtsumme aller Werte in der aggregierten Menge. Entspricht der SPARQL-Funktion SUM().</skos:definition>
        <skos:definition xml:lang="en">Computes the total sum of all values in the aggregated set. Corresponds to the SPARQL function SUM().</skos:definition>
        <skos:inScheme rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
        <skos:notation>SUM</skos:notation>
        <skos:prefLabel xml:lang="en">Sum</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Summe</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperatorScheme/1.0"/>
    </owl:NamedIndividual>
    


    <!-- https://semantic.adorsys.com/meta/kpi/Variance -->


    <owl:NamedIndividual rdf:about="https://semantic.adorsys.com/meta/kpi/Variance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://semantic.adorsys.com/meta/kpi/AggregationOperator"/>
